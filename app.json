{
  "expo": {
    "name": "Dhruv",
    "slug": "smokeless-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "dhruv",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/17f089b4-8579-460c-8dc9-f96f44732258",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smokeless.ai"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#101426"
      },
      "package": "com.smokeless.ai"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#F0C070",
          "sounds": []
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "expo-splash-screen",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Dhruv uses Face ID to keep your entries private."
        }
      ],
      [
        "expo-quick-actions",
        {
          "androidIcons": {
            "urge": {
              "foregroundImage": "./assets/android-icon-monochrome.png",
              "backgroundColor": "#101426"
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "17f089b4-8579-460c-8dc9-f96f44732258"
      }
    }
  }
}
