# Copy to .env and fill in. .env is gitignored.
#
# Both values below are safe to ship inside the app: the anon key is designed
# to be public and every table is protected by RLS (supabase/schema.sql).
#
# The Gemini key is NOT here on purpose. It is a Supabase Edge Function secret
# and never touches the app bundle — see SETUP.md step 4.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
