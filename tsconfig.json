{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    // Deno, not React Native: it uses `Deno.serve` and .ts import specifiers,
    // neither of which type-checks under the app's config. Its shared imports
    // (supabase/functions/_shared/**) are still checked here, because
    // src/services/ai/* re-exports them into the app's program.
    "supabase/functions/ai-coach"
  ]
}
